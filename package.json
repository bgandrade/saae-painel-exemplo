{
  "name": "saae-angra-painel",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "type": "module",
  "description": "Simulador de saneamento de Angra dos Reis — iniciativa pessoal de Bruno Andrade desenvolvida como proposta ao SAAE",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "documento:html": "node tools/gerar_documento.mjs --html-only",
    "documento:pdf": "node tools/gerar_documento.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node tools/check_geo.mjs && node tools/check_telas.mjs && node tools/check_demos.mjs && node tools/check_mapa_overlay.mjs",
    "check:geo": "node tools/check_geo.mjs",
    "check:telas": "node tools/check_telas.mjs",
    "check:demos": "node tools/check_demos.mjs",
    "check:mapa": "node tools/check_mapa_overlay.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "markdown-it": "^15.0.3",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.9.10",
    "vite": "^7.3.7"
  },
  "license": "MIT",
  "author": "Bruno Andrade",
  "repository": {
    "type": "git",
    "url": "https://github.com/bgandrade/saae-painel-exemplo.git"
  },
  "homepage": "https://saae-painel.pages.dev/",
  "bugs": {
    "url": "https://github.com/bgandrade/saae-painel-exemplo/issues"
  }
}
