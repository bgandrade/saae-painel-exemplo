# Cloudflare Pages — cabeçalhos do site estático.

/assets/*
  # Conteúdo versionado junto com o deploy: pode ficar muito tempo em cache.
  Cache-Control: public, max-age=31536000, immutable

/index.html
  # O HTML é o único ponto de entrada e o roteamento é por hash, então
  # revalidar sempre aqui basta para uma republicação aparecer na hora.
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  # O painel não carrega nada de fora — nem fonte, nem tile de mapa, nem CDN.
  # A CSP abaixo trava isso: se algum dia alguém acrescentar uma dependência
  # externa, ela falha aqui em vez de falhar no auditório sem internet.
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'none'; frame-ancestors 'none'
